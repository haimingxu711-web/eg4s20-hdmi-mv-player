// =====================================================================
// 像素流总线（全工程统一）：一根 47 位的线打包整组视频信号
//
//   位段:  [46] vs  [45] hs  [44] de  [43:34] x  [33:24] y  [23:0] rgb
//   vs/hs : 场/行同步（640x480@60 下低有效）
//   de    : 有效像素
//   x, y  : 当前像素坐标（de=1 时有效，0~639 / 0~479）
//   rgb   : {R[7:0], G[7:0], B[7:0]}
//
// 每级处理模块只需一根输入 vi、一根输出 vo：
//   wire [`VB-1:0] v0, v1;
//   fx_xxx u_xxx(.clk(clk), .rst(rst), .vi(v0), .vo(v1), ...);
// =====================================================================
`ifndef VID_DEFS_VH
`define VID_DEFS_VH

`define VB 47                       // 总线宽度

// ---- 从总线取字段 ----
`define VS(v)  v[46]
`define HS(v)  v[45]
`define DE(v)  v[44]
`define X(v)   v[43:34]
`define Y(v)   v[33:24]
`define RGB(v) v[23:0]

// ---- 从 24 位颜色取分量 ----
`define R8(c)  c[23:16]
`define G8(c)  c[15:8]
`define B8(c)  c[7:0]

// ---- 用新的颜色替换总线里的 rgb，其余字段不变 ----
`define VSET_RGB(v, c) {v[46:24], c}

`endif
